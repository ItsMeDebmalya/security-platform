# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Identity -----------------------------------------------------------
# Sent as the User-Agent on every outbound HTTP request so targets can
# identify us and find our opt-out page.
SP_USER_AGENT="SecurityPlatform-Scanner/0.1 (+https://example.invalid/scanner)"
# Org that owns scans run from this checkout. Present on every row from day one.
SP_ORG_ID=org_internal

# --- DNS ----------------------------------------------------------------
# Comma-separated resolvers. Empty = system resolvers.
SP_DNS_RESOLVERS=1.1.1.1,8.8.8.8
SP_DNS_TIMEOUT_S=5

# --- Rate limiting ------------------------------------------------------
SP_RATE_PER_HOST_RPS=2
SP_RATE_BURST=5
SP_MAX_CONCURRENCY_PER_ORG=8

# --- Safety -------------------------------------------------------------
# Path to the interim authorised-scope file (docs/09-ownership-verification.md).
SP_AUTHORISED_SCOPE=config/authorised_scope.yaml
# Set to 1 to stop every running scan immediately.
SP_KILLSWITCH=0

# --- Evidence -----------------------------------------------------------
SP_EVIDENCE_MAX_BODY_BYTES=262144

# --- Out-of-band callback server (Phase 2a; stub raises until then) ------
SP_OOB_DOMAIN=
SP_OOB_TOKEN=
