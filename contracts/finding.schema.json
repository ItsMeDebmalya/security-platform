{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-platform.invalid/contracts/finding.schema.json",
  "title": "Finding",
  "description": "A thing we believe about a target. Severity, confidence and state are three separate axes; state is derived by core/state.py and never hand-set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "org_id", "scanner", "scanner_version", "check_id", "title",
    "target", "location", "severity", "confidence", "confidence_provisional",
    "state", "detection_methods", "validation", "evidence", "status",
    "description", "impact", "remediation",
    "first_seen", "first_seen_scan_id", "last_seen", "last_seen_scan_id"
  ],
  "if": { "required": ["state_change"], "properties": { "state_change": { "type": "object" } } },
  "then": { "required": ["engagement"], "properties": { "engagement": { "const": "offensive" } } },
  "properties": {
    "vantage": { "enum": ["external_unauthenticated", "authenticated", "agent", null], "description": "ADR-034 (additive): where the finding was observed from. null = not recorded (every finding before ADR-034); never backfilled." },
    "engagement": { "enum": ["defensive", "offensive", null], "description": "ADR-034 (additive): the nature of the interaction with the target, defensive or offensive. Not named mode, which means depth. null = not recorded." },
    "links": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/finding_link" }, "description": "ADR-034 (additive): this finding explains or chains to other findings, by id. No repeats (uniqueItems). No self-links: enforced by the model only, because JSON Schema cannot compare a link with the finding's own id." },
    "state_change": { "oneOf": [ { "$ref": "#/$defs/state_change" }, { "type": "null" } ], "description": "ADR-034 (additive): allowed only when engagement is offensive." },
    "id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256(scanner + check_id + target.value + normalise(location) + (instance_key or '')). scanner_version is deliberately not an input."
    },
    "org_id": { "type": "string", "minLength": 1 },
    "scanner": { "type": "string", "minLength": 1 },
    "scanner_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "check_id": { "type": "string", "minLength": 1 },
    "renamed_from": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Former check_ids. A stored finding whose check_id appears here is the same finding."
    },
    "title": { "type": "string", "minLength": 1 },

    "target": { "$ref": "#/$defs/asset" },
    "location": {
      "type": "string",
      "minLength": 1,
      "description": "Where precisely. The reserved value '$' means the target as a whole."
    },
    "instance_key": {
      "type": ["string", "null"],
      "description": "Discriminator when one check legitimately fires more than once at one location - typically the payload_id."
    },

    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence_provisional": { "type": "boolean" },
    "state": {
      "enum": ["confirmed", "highly_likely", "suspected", "informational", "inconclusive"]
    },
    "no_verdict_reason": {
      "type": ["string", "null"],
      "description": "Set when the check ran but reached no verdict. Its presence is what makes state inconclusive.",
      "enum": ["timeout", "servfail", "waf_block", "blocked_prerequisite", "oob_unavailable", "ambiguous_response", "rate_limited", null]
    },

    "detection_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "likelihood_ratio", "independence_class", "prior", "prior_justification"],
        "properties": {
          "method": { "type": "string", "minLength": 1 },
          "likelihood_ratio": { "type": "number", "exclusiveMinimum": 0 },
          "independence_class": { "type": "string", "minLength": 1 },
          "prior": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
          "prior_justification": { "type": "string", "minLength": 1 }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "outcome"],
      "properties": {
        "attempted": { "type": "boolean" },
        "outcome": { "enum": ["passed", "failed", "unavailable", "not_applicable"] },
        "method": { "type": ["string", "null"] }
      }
    },

    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://security-platform.invalid/contracts/evidence.schema.json" }
    },
    "related_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value", "relation"],
        "properties": {
          "type": { "type": "string" },
          "value": { "type": "string" },
          "relation": { "type": "string" }
        }
      }
    },

    "status": { "enum": ["open", "closed", "accepted_risk", "false_positive"] },
    "status_history": {
      "type": "array",
      "description": "Populated from Phase 6; the field exists from day one.",
      "items": {
        "type": "object",
        "required": ["from", "to", "at", "by"],
        "properties": {
          "from": { "type": ["string", "null"] },
          "to": { "type": "string" },
          "at": { "type": "string", "format": "date-time" },
          "by": { "type": "string" },
          "scan_id": { "type": ["string", "null"] }
        }
      }
    },

    "description": { "type": "string", "minLength": 1 },
    "impact": { "type": "string", "minLength": 1 },
    "remediation": { "type": "string", "minLength": 1 },
    "references": { "type": "array", "items": { "type": "string" } },
    "taxonomy": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },

    "first_seen": { "type": "string", "format": "date-time" },
    "first_seen_scan_id": { "type": "string", "minLength": 1 },
    "last_seen": { "type": "string", "format": "date-time" },
    "last_seen_scan_id": { "type": "string", "minLength": 1 },
    "cost": { "$ref": "#/$defs/cost" },

    "materialises_at": {
      "type": ["string", "null"],
      "format": "date",
      "description": "When this finding becomes true. null means true now - every finding before v3.4, and almost everything since. Set, it names a future date on which the world's rules change, not our confidence in what we observed."
    },
    "materialises_reason": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "What changes on materialises_at. Required when materialises_at is set; meaningless without it."
    },
    "derivation": {
      "enum": ["detected", "derived"],
      "default": "detected",
      "description": "detected: we looked at the target, confidence comes from the confidence engine. derived: we applied a rule to something already detected, and confidence is inherited from derived_from rather than recalculated."
    },
    "derived_from": {
      "type": ["string", "null"],
      "description": "The id of the finding this was computed from. Required when derivation is 'derived'; forbidden when it is 'detected'."
    },
    "redaction_receipts": {
      "type": "array",
      "items": {
        "$ref": "https://security-platform.invalid/contracts/evidence.schema.json#/$defs/redaction_receipt"
      },
      "description": "ADR-029 (additive): the evidence's receipts rolled up, where prefixed by evidence index. Computed by the model, never taken from input."
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["domain", "url", "ip", "cidr", "repo", "cloud_account", "image", "email", "host"], "description": "host (ADR-034): a server reported by the agent; value is its hostname, or its IP address when it has none." },
        "value": { "type": "string", "minLength": 1 },
        "addresses": {
          "type": "array",
          "items": { "anyOf": [ { "format": "ipv4", "type": "string" }, { "format": "ipv6", "type": "string" } ] },
          "description": "ADR-034 (additive): the IP addresses the agent reported. Allowed only on a host asset. format is advisory (not asserted by default, like date-time); the model enforces IP literals, refusing IPv6 scope ids, so it agrees with these formats when they are asserted."
        }
      },
      "if": { "required": ["addresses"], "properties": { "addresses": { "minItems": 1 } } },
      "then": { "properties": { "type": { "const": "host" } } }
    },
    "finding_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "finding_id"],
      "properties": {
        "relation": { "enum": ["explains", "chains_to"], "description": "explains = this finding explains the linked one (inside-out correlation); chains_to = an attack-path step to it. Only the forward direction is stored." },
        "finding_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "state_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changes", "cleanup"],
      "description": "ADR-034: what an offensive test changed on the target, and how it was undone. Emitted by nothing in the Alpha; refused at runtime until a later ADR lifts the guard (ADR-004, ADR-025).",
      "properties": {
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "what", "where"],
            "properties": {
              "action": { "enum": ["created", "modified", "deleted"] },
              "what": { "type": "string", "minLength": 1 },
              "where": { "type": "string", "minLength": 1 }
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["not_needed", "pending", "done", "failed", "not_possible"] },
            "performed_at": { "type": ["string", "null"], "format": "date-time" },
            "detail": { "type": "string" }
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "integer", "minimum": 0 },
        "wall_ms": { "type": "integer", "minimum": 0 },
        "ai_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  },
