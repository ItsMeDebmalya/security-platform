{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-platform.invalid/contracts/evidence.schema.json",
  "title": "Evidence",
  "description": "What makes a finding defensible. Structured, never a blob of text. Every kind carries a control alongside its test, in whatever form the kind allows.",
  "type": "object",
  "required": [
    "kind",
    "label",
    "captured_at"
  ],
  "properties": {
    "kind": {
      "enum": [
        "http_pair",
        "oob_callback",
        "timing",
        "dns_answer",
        "tls_handshake",
        "screenshot",
        "file_excerpt",
        "command_output",
        "access_matrix"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fields removed at capture time. We never hold a customer secret."
    },
    "redaction_receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/redaction_receipt"
      },
      "description": "ADR-029 (additive): a receipt per kind and part removed at capture."
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/http_pair"
    },
    {
      "$ref": "#/$defs/oob_callback"
    },
    {
      "$ref": "#/$defs/timing"
    },
    {
      "$ref": "#/$defs/dns_answer"
    },
    {
      "$ref": "#/$defs/tls_handshake"
    },
    {
      "$ref": "#/$defs/command_output"
    },
    {
      "$ref": "#/$defs/file_excerpt"
    },
    {
      "$ref": "#/$defs/access_matrix"
    },
    {
      "$ref": "#/$defs/file_excerpt_derived"
    },
    {
      "$ref": "#/$defs/reserved"
    }
  ],
  "$defs": {
    "http_message": {
      "type": "object",
      "required": [
        "request",
        "response"
      ],
      "properties": {
        "request": {
          "type": "object",
          "required": [
            "method",
            "url"
          ],
          "properties": {
            "method": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "headers": {
              "type": "object"
            },
            "body": {
              "type": [
                "string",
                "null"
              ]
            },
            "body_truncated": {
              "type": "boolean"
            }
          }
        },
        "response": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "integer"
            },
            "headers": {
              "type": "object"
            },
            "body": {
              "type": [
                "string",
                "null"
              ]
            },
            "body_truncated": {
              "type": "boolean"
            },
            "elapsed_ms": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      }
    },
    "http_pair": {
      "properties": {
        "kind": {
          "const": "http_pair"
        },
        "control": {
          "$ref": "#/$defs/http_message"
        },
        "test": {
          "$ref": "#/$defs/http_message"
        },
        "delta": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "payload_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "control",
        "test"
      ]
    },
    "oob_callback": {
      "description": "The control is the absence of a callback: tokens emitted in the same run that were never hit.",
      "properties": {
        "kind": {
          "const": "oob_callback"
        },
        "token": {
          "type": "string"
        },
        "emitted_in": {
          "type": "string"
        },
        "emitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "window_s": {
          "type": "integer",
          "minimum": 1
        },
        "hit": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "received_at",
            "protocol",
            "raw_request"
          ],
          "properties": {
            "received_at": {
              "type": "string",
              "format": "date-time"
            },
            "source_ip": {
              "type": [
                "string",
                "null"
              ]
            },
            "protocol": {
              "enum": [
                "dns",
                "http",
                "https",
                "smtp"
              ]
            },
            "raw_request": {
              "type": "string"
            }
          }
        },
        "control_tokens_unhit": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "token",
        "emitted_in",
        "emitted_at",
        "window_s",
        "control_tokens_unhit"
      ]
    },
    "timing": {
      "description": "A single before/after pair is not how timing is validated. Samples, and a statistic.",
      "properties": {
        "kind": {
          "const": "timing"
        },
        "baseline_samples_ms": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 5
        },
        "test_samples_ms": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 5
        },
        "n": {
          "type": "integer",
          "minimum": 10
        },
        "delta_ms": {
          "type": "number"
        },
        "method": {
          "enum": [
            "welch_t",
            "mann_whitney"
          ]
        },
        "p_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "payload_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "baseline_samples_ms",
        "test_samples_ms",
        "n",
        "delta_ms",
        "method",
        "p_value"
      ]
    },
    "dns_query": {
      "type": "object",
      "required": [
        "query",
        "answer"
      ],
      "properties": {
        "query": {
          "type": "object",
          "required": [
            "name",
            "rrtype"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "rrtype": {
              "type": "string"
            },
            "resolver": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "answer": {
          "type": "object",
          "required": [
            "rcode",
            "records"
          ],
          "properties": {
            "rcode": {
              "type": "string"
            },
            "records": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ttl": {
              "type": [
                "integer",
                "null"
              ]
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "dns_answer": {
      "description": "The control is normally a random-label probe proving the zone has no wildcard. Where no control is possible, control_rationale must say why.",
      "properties": {
        "kind": {
          "const": "dns_answer"
        },
        "test": {
          "$ref": "#/$defs/dns_query"
        },
        "control": {
          "oneOf": [
            {
              "$ref": "#/$defs/dns_query"
            },
            {
              "type": "null"
            }
          ]
        },
        "control_rationale": {
          "type": "string",
          "minLength": 1
        },
        "analysis": {
          "type": [
            "object",
            "null"
          ],
          "description": "What we made of the answer: a parse tree, a resolved include chain with its lookup count. The raw answer above is the observation; this is our reading of it, kept separate so a user can check our working."
        }
      },
      "required": [
        "kind",
        "test",
        "control_rationale"
      ]
    },
    "reserved": {
      "description": "screenshot is reserved: nothing needs it, and specifying a shape no scanner uses is how a contract acquires dead weight. Its shape is specified when the first scanner needs it; until then it carries the base fields and a stated rationale for its control. (file_excerpt left this block in ADR-037.)",
      "properties": {
        "kind": {
          "enum": [
            "screenshot"
          ]
        },
        "control_rationale": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "kind",
        "control_rationale",
        "data"
      ]
    },
    "tls_handshake": {
      "description": "What a server presented, paired with what a strictly-configured client made of it. `test` is the observation, taken with a deliberately permissive client so that obsolete and broken servers can be observed at all. `control` is normally the verifying client's verdict - trusted or not, and OpenSSL's own reason - but for protocol enumeration it is a second observation of the same server negotiating a current protocol.",
      "properties": {
        "kind": {
          "const": "tls_handshake"
        },
        "test": {
          "$ref": "#/$defs/tls_observation"
        },
        "control": {
          "type": [
            "object",
            "null"
          ]
        },
        "control_rationale": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "kind",
        "test",
        "control_rationale",
        "observed_at"
      ]
    },
    "tls_observation": {
      "type": "object",
      "required": [
        "host",
        "port",
        "reachable"
      ],
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "servername": {
          "type": [
            "string",
            "null"
          ]
        },
        "reachable": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "cipher": {
          "type": [
            "string",
            "null"
          ]
        },
        "cipher_bits": {
          "type": [
            "integer",
            "null"
          ]
        },
        "trusted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "verify_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "verify_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostname_matches": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "certificate": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "redaction_receipt": {
      "type": "object",
      "description": "ADR-029: what was removed, how many and from which part, never what it was. No value, prefix, length or hash.",
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "where": {
          "type": "string",
          "pattern": "^[a-z_]+(\\.[a-z0-9_]+)*$",
          "description": "A field path from a fixed vocabulary, never built from data."
        }
      },
      "required": [
        "kind",
        "count",
        "where"
      ],
      "additionalProperties": false
    },
    "command_output": {
      "description": "ADR-037. A fact derived from a command the host agent ran. argv is the exact argv the allowlist declared and the receipt recorded, never a shell string. output is the RELEVANT output and output_selection says how it was reduced from what was captured. A non-zero exit_status is legitimate evidence. The control is the allowlist entry's declared expectation; control_rationale states the pair in words.",
      "properties": {
        "kind": {
          "const": "command_output"
        },
        "control_rationale": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "argv",
            "exit_status",
            "output",
            "output_selection",
            "receipt_ref",
            "collected_at",
            "host_ref"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "exit_status": {
              "type": "integer"
            },
            "output": {
              "type": "string"
            },
            "output_selection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "detail",
                "captured_bytes",
                "truncated"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "lines_matching",
                    "whole",
                    "first_n_bytes"
                  ]
                },
                "detail": {
                  "type": "string"
                },
                "captured_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "truncated": {
                  "type": "boolean"
                }
              }
            },
            "receipt_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason_id",
                "command_index"
              ],
              "properties": {
                "reason_id": {
                  "type": "string",
                  "minLength": 1
                },
                "command_index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "description": "Ties this evidence to the receipt line that produced it. Evidence that cites no receipt line is evidence for something the snapshot does not record."
            },
            "collected_at": {
              "type": "string",
              "format": "date-time"
            },
            "host_ref": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{16}$",
              "description": "The first 16 hex digits of the snapshot's machine_id fingerprint. Never a hostname-only link."
            }
          }
        }
      },
      "required": [
        "kind",
        "control_rationale",
        "data"
      ]
    },
    "file_excerpt": {
      "description": "ADR-037. A fact derived from a file on a host, moved out of `reserved` and specified. keys carries only what the file allowlist entry declared it may extract: a file is read, a file is not stored. stat is here because for several checks the mode is the finding. Distinguished from file_excerpt_derived by its host-observation fields; one that names any of them must carry all the required ones, receipt_ref included.",
      "properties": {
        "kind": {
          "const": "file_excerpt"
        },
        "control_rationale": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "keys",
            "excerpt",
            "receipt_ref",
            "collected_at",
            "host_ref"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "keys": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "excerpt": {
              "type": "string"
            },
            "line_numbers": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "stat": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "pattern": "^[0-7]{3,4}$"
                    },
                    "owner_uid": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "owner_group_gid": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "size_bytes": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "receipt_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason_id",
                "file_index"
              ],
              "properties": {
                "reason_id": {
                  "type": "string",
                  "minLength": 1
                },
                "file_index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "description": "Ties this evidence to the receipt line that produced it. Evidence that cites no receipt line is evidence for something the snapshot does not record."
            },
            "collected_at": {
              "type": "string",
              "format": "date-time"
            },
            "host_ref": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{16}$",
              "description": "The first 16 hex digits of the snapshot's machine_id fingerprint. Never a hostname-only link."
            }
          }
        }
      },
      "required": [
        "kind",
        "control_rationale",
        "data"
      ]
    },
    "file_excerpt_derived": {
      "description": "ADR-037: the file_excerpt shape that existed while the kind was reserved, kept valid. core/correlation.py and scanners/tls use it for evidence that is not a file at all (a composition rule, a testssl.sh probe), with a stated rationale for having no control. Valid only while `data` names none of the host-observation fields, so a host excerpt cannot shed its receipt_ref and slip in here. New code should not use it; a real kind for derived evidence is a follow-up.",
      "properties": {
        "kind": {
          "const": "file_excerpt"
        },
        "control_rationale": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "not": {
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "keys"
                ]
              },
              {
                "required": [
                  "excerpt"
                ]
              },
              {
                "required": [
                  "line_numbers"
                ]
              },
              {
                "required": [
                  "stat"
                ]
              },
              {
                "required": [
                  "receipt_ref"
                ]
              },
              {
                "required": [
                  "host_ref"
                ]
              },
              {
                "required": [
                  "collected_at"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "kind",
        "control_rationale",
        "data"
      ]
    },
    "access_matrix": {
      "description": "ADR-037. Who can read, write, export or delete a file, per principal. basis says where each principal's rights came from and derivation how the matrix was derived, because delete rights come from the PARENT directory, not the file: an unexplained can-delete would be an assertion dressed as an observation. acl null means no ACL support was observed, never that no ACL exists. members_observed is what the collector could read, not the group's whole membership.",
      "properties": {
        "kind": {
          "const": "access_matrix"
        },
        "control_rationale": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject_kind",
            "path",
            "stat",
            "principals",
            "derivation",
            "receipt_ref",
            "collected_at",
            "host_ref"
          ],
          "properties": {
            "subject_kind": {
              "enum": [
                "file",
                "directory"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "stat": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "type": "string",
                  "pattern": "^[0-7]{3,4}$"
                },
                "owner_uid": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "owner_group_gid": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "size_bytes": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            },
            "parent_stat": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "pattern": "^[0-7]{3,4}$"
                    },
                    "owner_uid": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "owner_group_gid": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "size_bytes": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "acl": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object"
              }
            },
            "principals": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "principal",
                  "members_observed",
                  "read",
                  "write",
                  "delete",
                  "basis"
                ],
                "properties": {
                  "principal": {
                    "type": "string",
                    "minLength": 1
                  },
                  "members_observed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "read": {
                    "type": "boolean"
                  },
                  "write": {
                    "type": "boolean"
                  },
                  "delete": {
                    "type": "boolean"
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "derivation": {
              "type": "string",
              "minLength": 1
            },
            "receipt_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason_id",
                "file_index"
              ],
              "properties": {
                "reason_id": {
                  "type": "string",
                  "minLength": 1
                },
                "file_index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "description": "Ties this evidence to the receipt line that produced it. Evidence that cites no receipt line is evidence for something the snapshot does not record."
            },
            "collected_at": {
              "type": "string",
              "format": "date-time"
            },
            "host_ref": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{16}$",
              "description": "The first 16 hex digits of the snapshot's machine_id fingerprint. Never a hostname-only link."
            }
          }
        }
      },
      "required": [
        "kind",
        "control_rationale",
        "data"
      ]
    }
  },
  "examples": [
    {
      "kind": "http_pair",
      "label": "Boolean-based SQL injection: true vs false condition",
      "captured_at": "2026-08-22T09:14:00Z",
      "redactions": [
        "set-cookie",
        "authorization"
      ],
      "redaction_receipts": [
        {
          "kind": "set-cookie",
